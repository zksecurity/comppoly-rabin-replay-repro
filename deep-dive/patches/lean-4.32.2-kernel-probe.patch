+char const * expr_kind_name(expr_kind kind) {
+    switch (kind) {
+    case expr_kind::BVar: return "BVar";
+    case expr_kind::Sort: return "Sort";
+    case expr_kind::Const: return "Const";
+    case expr_kind::MVar: return "MVar";
