+        ++probe.entries;
+        ++probe.current_depth;
+        if (probe.current_depth > probe.max_depth) probe.max_depth = probe.current_depth;
+        if (e.kind() == expr_kind::App) ++probe.app_entries;
+        std::string description = shallow_expr_description(e);
+        if (probe.recent.size() < 64) {
+            probe.recent.push_back(std::move(description));
