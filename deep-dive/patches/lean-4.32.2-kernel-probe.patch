+
+std::string shallow_expr_description(expr const & e) {
+    expr f = e;
+    size_t nargs = 0;
+    while (is_app(f)) {
+        ++nargs;
+        f = app_fn(f);
+    }
+    std::string result(expr_kind_name(e.kind()));
+    if (is_constant(f)) {
+        result += ":";
+        result += const_name(f).to_string();
+    } else if (f.kind() != e.kind()) {
+        result += ":head-";
+        result += expr_kind_name(f.kind());
+    }
+    if (nargs) {
+        result += "/";
+        result += std::to_string(nargs);
+    }
+    return result;
+}
