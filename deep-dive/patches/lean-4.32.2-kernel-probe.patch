+bool equiv_manager::is_cached_equiv(expr const & a, expr const & b) const {
+    auto ita = m_to_node.find(a);
+    if (ita == m_to_node.end()) return false;
+    auto itb = m_to_node.find(b);
+    if (itb == m_to_node.end()) return false;
+    return find_const(ita->second) == find_const(itb->second);
+}
