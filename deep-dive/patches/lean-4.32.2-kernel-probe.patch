+    for (char const * watched : {"Fintype.card", "Fintype.elems", "ZMod.card", "ZMod.fintype",
+                                 "Eq.mp", "Eq.mpr", "Eq.rec", "Eq.ndrec", "congrArg"}) {
+        auto it = trace.counts.find(watched);
+        std::cerr << "FAILED_UNFOLD_WATCH " << watched << " "
+                  << (it == trace.counts.end() ? 0 : it->second) << std::endl;
+    }
+    std::cerr << "FAILED_UNFOLD_LAST";
+    if (trace.last.size() < 64) {
+        for (auto const & name : trace.last) std::cerr << " " << name;
+    } else {
+        for (size_t i = 0; i < trace.last.size(); ++i)
+            std::cerr << " " << trace.last[(trace.next_last + i) % trace.last.size()];
