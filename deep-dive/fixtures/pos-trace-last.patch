+theorem irreducible_of_rabin_degree_six_of_three_cards
+    {F : Type*} [Field F] [Fintype F] {f : F[X]}
+    (qTrace qCop₃ qCop₂ : ℕ)
+    (hTraceCard : Fintype.card F = qTrace)
+    (hCop₃Card : Fintype.card F = qCop₃)
+    (hCop₂Card : Fintype.card F = qCop₂)
+    (h_deg : f.natDegree = 6)
+    (h_trace : f ∣ X ^ (qTrace ^ 6) - X)
+    (h_cop₃ : IsCoprime f (X ^ (qCop₃ ^ 3) - X))
+    (h_cop₂ : IsCoprime f (X ^ (qCop₂ ^ 2) - X)) :
+    Irreducible f := by
+  subst qTrace
+  subst qCop₃
+  subst qCop₂
+  exact irreducible_of_rabin_degree_six h_deg h_trace h_cop₃ h_cop₂
+
+/-- The same three-card adapter, with the three condition proofs supplied in
+the reverse order.  This controls the application-spine position of a concrete
+transport without changing its proposition. -/
+theorem irreducible_of_rabin_degree_six_of_three_cards_reversed
+    {F : Type*} [Field F] [Fintype F] {f : F[X]}
+    (qTrace qCop₃ qCop₂ : ℕ)
+    (hTraceCard : Fintype.card F = qTrace)
+    (hCop₃Card : Fintype.card F = qCop₃)
+    (hCop₂Card : Fintype.card F = qCop₂)
+    (h_deg : f.natDegree = 6)
+    (h_cop₂ : IsCoprime f (X ^ (qCop₂ ^ 2) - X))
+    (h_cop₃ : IsCoprime f (X ^ (qCop₃ ^ 3) - X))
+    (h_trace : f ∣ X ^ (qTrace ^ 6) - X) : Irreducible f := by
+  subst qTrace
+  subst qCop₃
+  subst qCop₂
+  exact irreducible_of_rabin_degree_six h_deg h_trace h_cop₃ h_cop₂
+
 end CompPoly.RabinCert
